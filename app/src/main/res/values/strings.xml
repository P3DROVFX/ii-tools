    <string name="clip_service_summary">Sends text you copy to your PC</string>
    <string name="clip_service_description">When you copy text, ii tools sends it to your paired PC. It only notices copy actions (a tap on Copy, a \"Copied\" message) and reads the clipboard for an instant; it never reads what is on screen.</string>
